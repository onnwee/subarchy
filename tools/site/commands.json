   "examples": [
    "subcult app webapp install \"Google Maps\" maps.google.com",
    "subcult app webapp remove \"Google Maps\""
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult calendar list",
   "group": "calendar",
   "args": "[--json]",
   "summary": "Show the cached events",
   "examples": [
    "subcult calendar list"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult calendar status",
   "group": "calendar",
   "args": "",
   "summary": "Show when the calendars last synced and how each source fared",
   "examples": [
    "subcult calendar status"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult calendar sync",
   "group": "calendar",
   "args": "[--force]",
