{
 "_source": "subcult commands --json; refresh with make site-commands",
 "commands": [
  {
   "route": "subcult agent usage",
   "group": "agent",
   "args": "[--json]",
   "summary": "Show the coding agents' token use today and this week, their pace and rate limits",
   "examples": [
    "subcult agent usage",
    "subcult agent usage --json"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app ask",
   "group": "app",
   "args": "<question>... | --json",
   "summary": "Ask the default agent one question and print its answer; --json names the agent",
   "examples": [
    "subcult app ask what does zram do",
    "subcult app ask --json"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app default",
   "group": "app",
   "args": "[<role> [<id>]] [--dry-run]",
   "summary": "Show or set the default app per role",
   "examples": [
    "subcult app default",
    "subcult app default browser",
    "subcult app default browser chromium"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app install",
   "group": "app",
   "args": "<id>... [--dry-run]",
   "summary": "Install apps from the catalogue",
   "examples": [
    "subcult app install steam lutris",
    "subcult app install freecad --dry-run"
   ],
   "requires_sudo": true,
   "dangerous": false
  },
  {
   "route": "subcult app list",
   "group": "app",
   "args": "[--role ROLE] [--json]",
   "summary": "List the app catalogue",
   "examples": [
    "subcult app list",
    "subcult app list --role browser"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app remove",
   "group": "app",
   "args": "<id>... [--dry-run]",
   "summary": "Remove apps installed from the catalogue",
   "examples": [
    "subcult app remove steam"
   ],
   "requires_sudo": true,
   "dangerous": true
  },
  {
   "route": "subcult app show",
   "group": "app",
   "args": "<id> [--json]",
   "summary": "Show one app",
   "examples": [
    "subcult app show vlc"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app validate",
   "group": "app",
   "args": "[file]",
   "summary": "Check the system and user catalogue files",
   "examples": null,
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult app webapp",
   "group": "app",
   "args": "install <name> <url> [--icon FILE] | remove <name>",
