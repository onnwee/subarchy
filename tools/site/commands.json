  {
   "route": "subcult clipboard list",
   "group": "clipboard",
   "args": "[--json]",
   "summary": "List the clipboard history, newest first",
   "examples": [
    "subcult clipboard list",
    "subcult clipboard list --json"
   ],
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult clipboard remove",
   "group": "clipboard",
   "args": "<id>",
   "summary": "Drop one entry from the history",
   "examples": null,
   "requires_sudo": false,
   "dangerous": false
  },
  {
   "route": "subcult clipboard show",
   "group": "clipboard",
   "args": "<id>",
   "summary": "Print a text entry, or the file holding an image entry",
