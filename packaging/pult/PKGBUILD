# Maintainer: SUBCULT <info@subcult.tv>
# Pult (ADR 0037, issues #77 and #78), applied at install and through `pult`.
# The v0.4.1 release PKGBUILD is vendored unchanged below this header.
# Its checksum-pinned source and catalog include KDE and swayimg; KDE
# distinguishes green keyboard focus from teal hover and active controls.
# Licence: GPL-3.0-only for code, MIT for templates and registry;
# both texts are installed under /usr/share/licenses/pult/.
# Template: scripts/render-packaging.sh fills the @...@ fields from a release.
pkgname=pult
pkgver=0.4.1
pkgrel=1
pkgdesc='Apply one palette across your terminal apps, and undo every change'
arch=('x86_64' 'aarch64')
url='https://git.subcult.tv/subculture-collective/pult'
license=('GPL-3.0-only' 'MIT')
makedepends=('go')
source=("https://git.subcult.tv/subculture-collective/pult/releases/download/v0.4.1/pult-0.4.1-src.tar.gz"
        "https://git.subcult.tv/subculture-collective/pult/releases/download/v0.4.1/pult-0.4.1-catalog.db.zst")
noextract=("pult-0.4.1-catalog.db.zst")
sha256sums=('1b36bbe8c10475b2b60127e313253bf972a7c9cf70c3ca791deadadeceb0a300'
            'c05372aa5f627d8875d6be499babe73abe30afa909b3557f9d520b356e1c4cc3')

build() {
  cd "pult-$pkgver"
  cp "$srcdir/pult-$pkgver-catalog.db.zst" builtin/catalog.db.zst
  export CGO_ENABLED=0
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-s -w -X main.version=$pkgver -X git.subcult.tv/subculture-collective/pult.BuiltinVersion=2026.11.16.0" -o pult ./cmd/pult
}

check() {
  cd "pult-$pkgver"
  CGO_ENABLED=0 go test ./...
}

package() {
  cd "pult-$pkgver"
  install -Dm755 pult "$pkgdir/usr/bin/pult"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES/MIT.txt "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
