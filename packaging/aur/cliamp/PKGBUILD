# Maintainer: bjarneo <https://github.com/bjarneo>
pkgname=cliamp
pkgver=2.4.1
pkgrel=2
pkgdesc='A retro terminal music player inspired by Winamp 2.x'
arch=('x86_64' 'aarch64')
url='https://github.com/bjarneo/cliamp'
# LicenseRefs name retained upstream texts; source-delivery review remains #84/#243.
license=('MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'Apache-2.0' 'ISC' 'LicenseRef-go-librespot-GPL-3.0' 'LicenseRef-Goja-LUCENE')
depends=('alsa-lib' 'flac' 'libvorbis' 'libogg' 'mpg123' 'ffmpeg' 'yt-dlp')
optdepends=('pipewire-alsa: audio output on PipeWire systems'
  'pulseaudio-alsa: audio output on PulseAudio systems'
  'python-secretstorage: read Chromium-based browser cookies from GNOME Keyring via yt-dlp')
# Subarchy: the C libraries cgo links against are also listed here, because
# packaging/aur/build.sh and CI install only makedepends (makepkg --nodeps).
makedepends=('go' 'alsa-lib' 'flac' 'libvorbis' 'libogg' 'mpg123')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/bjarneo/cliamp/archive/refs/tags/v${pkgver}.tar.gz"
        'THIRD-PARTY-NOTICES.txt'
        'THIRD-PARTY-NOTICES.provenance.json')
sha256sums=('fb5e43513b71287cd1db39403a293436b38db2ffa73fcd820a34ba3a73d2523e'
            'dfe3a75d767348dc966a7bf7e83fde8da8ada4bb2494b4bea38c3e189190e5b3'
            '87e5bcc6b4b4d38086c049b44d86b06472d226fade4a145ce04d88d4fc2d48f5')

build() {
    cd "${pkgname}-${pkgver}"
    export CGO_ENABLED=1
    go build -trimpath -buildmode=pie \
        -ldflags="-s -w -X main.version=v${pkgver} -linkmode=external" \
        -o cliamp .
}

package() {
    cd "${pkgname}-${pkgver}"
    install -Dm755 cliamp "${pkgdir}/usr/bin/cliamp"
    install -Dm644 cliamp.desktop "${pkgdir}/usr/share/applications/cliamp.desktop"
    install -Dm644 Cliamp.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cliamp.png"
    install -Dm644 Cliamp.png "${pkgdir}/usr/share/pixmaps/cliamp.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "$srcdir/THIRD-PARTY-NOTICES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
    install -Dm644 "$srcdir/THIRD-PARTY-NOTICES.provenance.json" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.provenance.json"
}
